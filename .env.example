# Copy this file to .env and adjust as needed. All values have safe defaults
# in backend/config.py, so .env is optional for local development.

APP_NAME=AeroTwin-X
ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite:///./data/synthetic/aerotwinx.db

TELEMETRY_TICK_SECONDS=1.0
TELEMETRY_HISTORY_MAX_FRAMES=3600

# Optional. If unset, the natural-language mission parser falls back to a
# deterministic rule-based parser and the app runs fully offline.
LLM_API_KEY=
LLM_ENABLED=false
